# NVIDIA
C2H_PROVIDER=nvidia
C2H_NVIDIA_API_KEY=
C2H_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
C2H_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Classification
C2H_CLASSIFIER_LLM_ENABLED=false

# Response timing
C2H_QUIET_WINDOW_MIN_S=8
C2H_QUIET_WINDOW_MAX_S=90

# Ledger
C2H_LEDGER_BASE_URL=http://localhost:8080
C2H_INTERNAL_API_SECRET=dev-internal-secret
